# Copy to .env and fill in.

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Reasoning effort for reasoning models (gpt-5 family). Leave EMPTY for non-reasoning
# models such as gpt-4.1 / gpt-4.1-mini, which reject this parameter.
OPENAI_REASONING_EFFORT=
# Optional label to group requests on the same OpenAI cache. Empty = not sent (default):
# an A/B test showed no difference in cache hits.
OPENAI_PROMPT_CACHE_KEY=

# --- Anthropic ---
# LLM_PROVIDER picks the model provider for the app: anthropic (default) or openai.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# low | medium | high | xhigh | max. Empty = the model's default (medium on Haiku 5.5).
ANTHROPIC_EFFORT=low

# --- Langfuse tracing (optional) ---
# With both keys set, the app sends one trace per chat turn to Langfuse. The eval sends traces only with --langfuse.
# LANGFUSE_BASE_URL: https://cloud.langfuse.com (EU, default) or https://us.cloud.langfuse.com (US).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- FAQ retrieval ---
# "embeddings": the model writes a query, FAQs are ranked by embedding similarity (default).
# "index": the model picks FAQs from the list of titles.
FAQ_RETRIEVER=embeddings
EMBEDDING_MODEL=text-embedding-3-small
FAQ_MIN_SIMILARITY=0.3

# --- Date ---
# The date the app treats as today (YYYY-MM-DD). Empty = the real date.
# The sample departures run from 2026-10-12 to 2027-09-29: set e.g. 2026-11-24 to demo them as on that day.
FIXED_TODAY=
